# Copy to .env on the server (never commit .env, never put it in OneDrive)
# Claude reads trip requests written in words. Empty = only "EWR TLV 2026-12-20 2027-01-03" or the form.
ANTHROPIC_API_KEY=
# Duffel (free search): app.duffel.com > Developers > Access tokens. Does the daily checks.
# A duffel_test_ token searches Duffel's sandbox airline only; use a live token for real prices.
DUFFEL_ACCESS_TOKEN=
# SerpApi (Google Flights): the same key price-agent uses. Empty = Google Flights off.
SERPAPI_KEY=
# Email over SMTP, e.g. Gmail: smtp.gmail.com / 587 / your address / an app password.
# Empty SMTP_HOST = emails are only queued (visible under "Runs & emails").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Comma-separated recipients
EMAIL_TO=
# 1 = offline demo data instead of real sources (try the dashboard without keys)
FLIGHTS_DEMO=
LOG_LEVEL=INFO
